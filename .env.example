# Copy this file to .env, set mode 0600, and keep it outside Git.
CODEX_SCREENER_PROVIDER=unusual_whales
UNUSUAL_WHALES_API_KEY=
CODEX_SCREENER_WATCHLIST=QCOM,ARM,INTC,AMD,NVDA
CODEX_SCREENER_TIMEZONE=America/New_York
CODEX_SCREENER_SNAPSHOT_TIME=06:45

# Private runtime state. This path is ignored by Git; an absolute path is also valid.
CODEX_SCREENER_HOME=./.codex-screener-private

CODEX_SCREENER_INTRADAY_DAILY_CAP=40000
CODEX_SCREENER_INTRADAY_RESERVE=7000
